generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model clientes {
  id              Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(150)
  numero_telefono String    @db.VarChar(20)
  direccion       String    @db.VarChar(150)
  ciudad          String    @db.VarChar(100)
  email           String    @unique(map: "email") @db.VarChar(150)
  pedidos         pedidos[]
}

model companias_envio {
  id              Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(150)
  numero_telefono String    @db.VarChar(20)
  pedidos         pedidos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_pedido {
  id              Int       @id @default(autoincrement())
  pedido_id       Int
  producto_id     Int
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  pedidos         pedidos   @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_detalle_pedido")
  productos       productos @relation(fields: [producto_id], references: [id], onUpdate: NoAction, map: "fk_detalle_producto")

  @@index([pedido_id], map: "fk_detalle_pedido")
  @@index([producto_id], map: "fk_detalle_producto")
}

model empleados {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(100)
  apellido      String    @db.VarChar(100)
  cargo         String    @db.VarChar(100)
  email         String    @unique(map: "email") @db.VarChar(150)
  fecha_ingreso DateTime  @db.Date
  pedidos       pedidos[]
}

model pedidos {
  id                Int              @id @default(autoincrement())
  fecha_pedido      DateTime         @default(now()) @db.DateTime(0)
  cliente_id        Int
  empleado_id       Int
  compania_envio_id Int
  detalle_pedido    detalle_pedido[]
  clientes          clientes         @relation(fields: [cliente_id], references: [id], onUpdate: NoAction, map: "fk_pedidos_cliente")
  companias_envio   companias_envio  @relation(fields: [compania_envio_id], references: [id], onUpdate: NoAction, map: "fk_pedidos_compania")
  empleados         empleados        @relation(fields: [empleado_id], references: [id], onUpdate: NoAction, map: "fk_pedidos_empleado")

  @@index([cliente_id], map: "fk_pedidos_cliente")
  @@index([compania_envio_id], map: "fk_pedidos_compania")
  @@index([empleado_id], map: "fk_pedidos_empleado")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model productos {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(150)
  categoria      String           @db.VarChar(150)
  marca          String           @db.VarChar(150)
  precio_pesos   Decimal          @db.Decimal(10, 2)
  stock          Int              @default(0)
  proveedor_id   Int
  detalle_pedido detalle_pedido[]
  proveedores    proveedores      @relation(fields: [proveedor_id], references: [id], onUpdate: NoAction, map: "fk_productos_proveedor")

  @@index([proveedor_id], map: "fk_productos_proveedor")
}

model proveedores {
  id              Int         @id @default(autoincrement())
  nombre          String      @db.VarChar(150)
  cuit_empresa    String      @unique(map: "cuit_empresa") @db.VarChar(13)
  numero_telefono String      @db.VarChar(20)
  direccion       String      @db.VarChar(150)
  email           String      @unique(map: "email") @db.VarChar(150)
  productos       productos[]
}
